# Django Backend Configuration
DEBUG=True
SECRET_KEY=change-in-production-django-insecure-secret-key-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80,http://localhost

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend Configuration
VITE_API_BASE_URL=/api
# Docker Compose only. For a separate Render frontend, use the backend's public HTTPS URL.
API_UPSTREAM=http://backend:8000/api/
